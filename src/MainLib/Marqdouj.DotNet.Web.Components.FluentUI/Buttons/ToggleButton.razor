<FluentButton Disabled="@Disabled" IconStart="@icon" Title="@Title" OnClick="@OnToggleStateChanged" Style="@Style" />

@code {
    private Icon icon => ToggleState ? IconTrue : IconFalse;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public Icon IconFalse { get; set; } = new Icons.Regular.Size20.AlertOff();

    [Parameter]
    public Icon IconTrue { get; set; } = new Icons.Regular.Size20.AlertOn();

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public bool ToggleState { get; set; }

    [Parameter]
    public EventCallback<bool> ToggleStateChanged { get; set; }

    private async Task OnToggleStateChanged()
    {
        ToggleState = !ToggleState;
        await ToggleStateChanged.InvokeAsync(ToggleState);
    }
}
