@rendermode InteractiveServer

<div class="navmenu">
    <input type="checkbox" title="Menu expand/collapse toggle" id="navmenu-toggle" class="navmenu-icon" />
    <label for="navmenu-toggle" class="navmenu-icon"><FluentIcon Value="@(new Icons.Regular.Size20.Navigation())" Color="Color.Fill" /></label>
    <nav class="sitenav" aria-labelledby="main-menu">
        <FluentNavMenu Id="main-menu" Collapsible="true" Width="250" Title="Navigation menu" @bind-Expanded="expanded" CustomToggle="true">
            <FluentNavLink Href="/" Match="NavLinkMatch.All" Icon="@(new Icons.Regular.Size20.Home())" IconColor="Color.Accent">Home</FluentNavLink>
            <FluentNavLink Href="test-buttons" Icon="@(new Icons.Regular.Size20.DesignIdeas())" IconColor="Color.Accent">Buttons</FluentNavLink>
            <FluentNavGroup Title="Themes" Icon="@(new Icons.Regular.Size20.GroupList())" IconColor="Color.Accent">
                <FluentNavLink Href="test-themecolor" Icon="@(new Icons.Regular.Size20.DesignIdeas())" IconColor="Color.Accent">ThemeColor</FluentNavLink>
                <FluentNavLink Href="test-thememode" Icon="@(new Icons.Regular.Size20.DesignIdeas())" IconColor="Color.Accent">ThemeMode</FluentNavLink>
                <FluentNavLink Href="test-themeselect" Icon="@(new Icons.Regular.Size20.DesignIdeas())" IconColor="Color.Accent">ThemeSelect</FluentNavLink>
                <FluentNavLink Href="test-themetoggle" Icon="@(new Icons.Regular.Size20.DesignIdeas())" IconColor="Color.Accent">ThemeToggle</FluentNavLink>
            </FluentNavGroup>
        </FluentNavMenu>
    </nav>
</div>

@code {
    private bool expanded = true;
}
